{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "BASE_PATH=/invariant/ pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/invariant/", "permanent": false },
    { "source": "/invariant", "destination": "/invariant/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/invariant/", "destination": "/index.html" },
    { "source": "/invariant/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/invariant/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/invariant/z3/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
