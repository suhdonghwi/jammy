{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/invariant",
      "destination": "/invariant/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/invariant/",
      "destination": "https://invariant-frog.vercel.app/invariant/"
    },
    {
      "source": "/invariant/:path*",
      "destination": "https://invariant-frog.vercel.app/invariant/:path*"
    }
  ]
}
